    document.getElementById('chat-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      let input = document.getElementById('message-input');
      let btn = document.getElementById('btn-submit');
      let texto = input.value.trim();
      if (!texto) return;

      let usuario = obtenerUsuario();
      btn.disabled = true;
      btn.innerText = "...";

      try {
        // 1. Intentar obtener el archivo
        let getRes = await fetch(`https://api.github.com/repos/${GITHUB_USER}/${REPO_NAME}/contents/database.json?cache=${Date.now()}`, {
          headers: {
            'Authorization': `token ${GITHUB_TOKEN}`,
            'Accept': 'application/vnd.github.v3+json'
          }
        });

        if (!getRes.ok) {
          let errData = await getRes.json();
          alert(`Error GitHub (${getRes.status}): ${errData.message}`);
          return;
        }

        let fileData = await getRes.json();
        let currentSha = fileData.sha;
        let dbData = JSON.parse(b64_to_utf8(fileData.content));

        if (!dbData.channels) dbData.channels = {};
        if (!dbData.channels[canalActual]) dbData.channels[canalActual] = [];

        let horaActual = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        dbData.channels[canalActual].push({
          user: usuario,
          text: texto,
          time: horaActual
        });

        // 2. Guardar archivo actualizado
        let putRes = await fetch(`https://api.github.com/repos/${GITHUB_USER}/${REPO_NAME}/contents/database.json`, {
          method: 'PUT',
          headers: {
            'Authorization': `token ${GITHUB_TOKEN}`,
            'Content-Type': 'application/json',
            'Accept': 'application/vnd.github.v3+json'
          },
          body: JSON.stringify({
            message: `💬 Mensaje de ${usuario}`,
            content: utf8_to_b64(JSON.stringify(dbData, null, 2)),
            sha: currentSha
          })
        });

        if (putRes.ok) {
          input.value = '';
          await cargarMensajes();
          let box = document.getElementById('messages-box');
          box.scrollTop = box.scrollHeight;
        } else {
          let errData = await putRes.json();
          alert(`Error al guardar (${putRes.status}): ${errData.message}`);
        }

      } catch (err) {
        console.error("Error al enviar:", err);
        alert("Error de conexión: " + err.message);
      } finally {
        btn.disabled = false;
        btn.innerText = "Enviar";
      }
    });
